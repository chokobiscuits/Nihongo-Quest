{
  "name": "nihongo-quest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate && git config core.hooksPath .githooks || true",
    "verify": "npm run typecheck && npm run test && npm run build",
    "verify:reset": "tsx --env-file=.env scripts/verify-reset.ts",
    "verify:practice-cap": "tsx --env-file=.env scripts/verify-practice-cap.ts",
    "seed:download": "tsx scripts/seed/download.ts",
    "seed:transform": "tsx scripts/seed/transform.ts",
    "seed:load": "tsx scripts/seed/load.ts",
    "seed:load-tutorials": "tsx scripts/seed/load-tutorials.ts",
    "sim": "tsx scripts/sim/progression.ts",
    "mnemonics:generate": "tsx scripts/mnemonics/generate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.112.0",
    "clsx": "^2.1.1",
    "marked": "^18.0.7",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tar-stream": "^3.2.0",
    "unbzip2-stream": "^1.4.3",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sax": "^1.2.7",
    "@types/tar-stream": "^3.1.4",
    "adm-zip": "^0.6.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "iconv-lite": "^0.7.3",
    "jsdom": "^29.1.1",
    "prisma": "^7.8.0",
    "sax": "^1.6.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
