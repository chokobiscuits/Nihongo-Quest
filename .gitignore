# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# seed pipeline: raw downloads and generated JSONL artifacts, both
# regenerable via `npm run seed:download` / `npm run seed:transform`
/data/
# ...except hand-authored content, which is NOT regenerable from any source
# and would be lost with the database.
!/data/authored/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local agent workspace, not part of the app
.claude

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Design reference material (source mockups, not app assets)
/Assets/

# User-uploaded avatars — local disk only, see src/lib/storage.ts
/public/uploads/avatars/*
!/public/uploads/avatars/.gitkeep
