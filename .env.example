# ---------------------------------------------------------------- Database
# Supabase: DATABASE_URL is the pooled (pgbouncer) connection used by the app.
# DIRECT_URL is the direct connection, used only to run migrations.
DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host:5432/postgres"

# ---------------------------------------------------------------- Supabase
# Project URL and anon key, if the client ever talks to Supabase directly
# (storage, realtime). Not required for the Prisma-only data path.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------- App
# Single-user app: no auth, no RLS. This just names the one user row seeded
# into UserProfile.
APP_USER_ID="local-user"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------- Mnemonics
# Optional, only needed to run `npm run mnemonics:generate` for real (see
# scripts/mnemonics/README.md). Without it, the script's mock/--dry-run
# modes still work for testing.
ANTHROPIC_API_KEY=""
# Optional override of the model id used by the real client; defaults to a
# current Claude model — see scripts/mnemonics/client.ts.
ANTHROPIC_MODEL=""
