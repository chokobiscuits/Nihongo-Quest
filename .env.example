# ---------------------------------------------------------------- Database
# Supabase: DATABASE_URL is the pooled (pgbouncer) connection used by the app.
# DIRECT_URL is the direct connection, used only to run migrations.
DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host:5432/postgres"

# ---------------------------------------------------------------- Supabase
# Project URL and anon key, used both for direct client access (storage,
# realtime) and as the fallback credential for the avatar Storage driver
# below. Not required for the Prisma-only data path.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only, never exposed to the client. Preferred over the anon key for
# the Storage driver when present since it bypasses bucket policies cleanly.
# Optional: the anon key alone is enough for a public bucket.
SUPABASE_SERVICE_ROLE_KEY=""
# Bucket name for avatar uploads (src/lib/storage.ts). Must exist and be
# public. Defaults to "avatars" if unset.
SUPABASE_STORAGE_BUCKET="avatars"

# ---------------------------------------------------------------------- App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --------------------------------------------------------------- Per-user auth
# Real per-user accounts via Supabase Auth — see
# docs/multi-user-auth-migration.md. src/app/api/login/route.ts looks up the
# submitted username in `auth_username_map` (service role only) and checks
# the password against Supabase Auth, then sets its own signed session
# cookie carrying that user's UserProfile.userId. src/proxy.ts requires a
# valid session cookie on every route except /login and /api/login — there
# is no way to disable this gate (unlike the old single APP_PASSWORD gate).
#
# Provision accounts with `npx tsx scripts/provision-auth-users.ts` — see
# that script's header comment for required env vars and usage.
#
# APP_SESSION_SECRET: HMAC key used to sign the session cookie. Generate with
# `openssl rand -hex 32` (or any long random string) — never reuse elsewhere.
APP_SESSION_SECRET=""
# SUPABASE_URL: server-only Supabase project URL for the Admin API client
# (src/lib/supabaseAdmin.ts). Falls back to NEXT_PUBLIC_SUPABASE_URL if unset.
SUPABASE_URL=""

# ---------------------------------------------------------------- Mnemonics
# Optional, only needed to run `npm run mnemonics:generate` for real (see
# scripts/mnemonics/README.md). Without it, the script's mock/--dry-run
# modes still work for testing.
ANTHROPIC_API_KEY=""
# Optional override of the model id used by the real client; defaults to a
# current Claude model — see scripts/mnemonics/client.ts.
ANTHROPIC_MODEL=""

# ------------------------------------------------------------ Pronunciation
# Optional. Base URL of the public Supabase Storage bucket holding the
# pre-generated VOICEVOX clips (see scripts/audio/generate.ts). Without it,
# the speaker buttons use the browser's built-in Japanese voice only.
# Build-time value: set it before `next build`.
# <supabase-url>/storage/v1/object/public/speech-audio
NEXT_PUBLIC_SPEECH_AUDIO_BASE_URL=""
# Optional, generator only: VOICEVOX engine address and bucket name.
# VOICEVOX_URL="http://127.0.0.1:50021"
# SPEECH_AUDIO_BUCKET="speech-audio"
