// Choko Japan data model.
//
// Single user, so there is no User table and no RLS: every row belongs to
// the one person running this instance. `UserProfile.userId` and the various
// `userId` columns exist anyway so the schema does not have to be reshaped if
// this ever grows multi-user, and so seed/export scripts have something
// concrete to key on.
//
// The other idea driving this schema: seeded dictionary content (JMdict,
// KanjiVG, WaniKani-style subject data — all CC BY-SA) and the user's own
// writing (mnemonics, hints, accepted-meaning synonyms) must stay cleanly
// separable. See the "USER-AUTHORED" block on Subject below: those fields are
// never touched by the seed scripts and must be excludable from any export
// that redistributes seeded content under CC BY-SA without also publishing
// personal notes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: connection URLs live in prisma.config.ts, and the runtime client
// takes a driver adapter instead of a URL. See src/lib/db.ts.
datasource db {
  provider = "postgresql"
}

enum SubjectType {
  KANA
  RADICAL
  KANJI
  VOCAB
  GRAMMAR
  SENTENCE
  READING
}

enum QuestionType {
  MEANING
  READING
}

enum SessionKind {
  LESSON
  REVIEW
  EXAM
}

// ------------------------------------------------------------------ Subjects

model Subject {
  id    String      @id @default(cuid())
  type  SubjectType
  /// Curriculum level 1-60, or null when the subject is seeded but not part
  /// of the ladder (searchable/linkable from other subjects, not scheduled
  /// in lessons). See scripts/seed/lib/level-heuristic.ts.
  level Int?
  slug  String      @unique

  characters String?
  imageUrl   String?

  /// Seeded from dictionary sources. Shape: string[] with a "primary" flag
  /// pattern left to the app layer (WaniKani-style [{ meaning, primary }]).
  meanings Json
  /// Seeded from dictionary sources. Same shape as `meanings`.
  readings Json

  // ---------------------------------------------------------- USER-AUTHORED
  // Everything below this line is written by the user, never by a seed
  // script. Kept together and clearly labeled so a future "export my seeded
  // library" job can select every column above this block and skip these —
  // the seeded content is CC BY-SA and redistributable, this is not.
  meaningMnemonic  String?
  readingMnemonic  String?
  meaningHint      String?
  readingHint      String?
  /// Synonym whitelist: alternate meanings the user wants accepted as
  /// correct, on top of whatever `meanings` already allows.
  acceptedMeanings Json    @default("[]")
  authored         Boolean @default(false)
  /// Provenance of the mnemonic/hint fields above: null (never touched),
  /// "generated" (written by scripts/mnemonics/generate.ts, safe to
  /// regenerate), or "authored" (hand-edited by the user through the
  /// mnemonic editor, never overwritten by a regeneration pass). Distinct
  /// from `authored`, which only tracks acceptedMeanings edits via the
  /// meaning-accept escape hatch as well as mnemonic edits — this column
  /// exists so the generator can tell "never generated" apart from "user
  /// took over" without conflating the two.
  mnemonicSource   String?
  // ------------------------------------------------------ END USER-AUTHORED

  jlpt       Int?
  jlptLegacy Int?
  frequency  Int?
  /// Free-form seeded metadata that doesn't merit its own column (parts of
  /// speech, KanjiVG stroke count, source ids, ...).
  metadata   Json    @default("{}")

  /// JmdictFurigana-shaped segment array: [{ ruby, rt? }, ...]. Null when no
  /// furigana entry exists for this subject.
  furigana         Json?
  /// True when `furigana` had to be synthesized as a single whole-word ruby
  /// span rather than sourced from JmdictFurigana per-character segments.
  furiganaFallback Boolean @default(false)

  parentLinks SubjectComponent[] @relation("SubjectAsParent")
  childLinks  SubjectComponent[] @relation("SubjectAsChild")
  userSubject UserSubject[]

  @@index([type, level])
  @@index([jlpt])
}

/// Composition edges: which Subjects make up which other Subjects (radicals
/// inside kanji, kanji inside vocab, ...). Sourced from KanjiVG for the
/// radical/kanji layer.
model SubjectComponent {
  parentId String
  childId  String

  /// KanjiVG-style placement of the child within the parent glyph.
  position String?
  isRadical Boolean @default(false)
  /// The specific reading of the child that is "in play" for this
  /// composition, when relevant (e.g. the on'yomi that gives a phonetic
  /// component its sound in the parent kanji).
  readingUsed String?
  /// True when this edge should gate its parent's runtime unlock — see
  /// src/services/srs/unlock.ts's componentsSatisfied, which only considers
  /// gating components. Every RADICAL/KANJI/VOCAB component edge is gating.
  /// SENTENCE -> VOCAB edges are gating only for the sentence's content-word
  /// vocab (nouns, verbs, adjectives, adverbs); function-word vocab
  /// (particles, copula, auxiliaries, ...) still gets an edge for
  /// UI highlighting/linking, but must not block unlock.
  isGating Boolean @default(true)

  parent Subject @relation("SubjectAsParent", fields: [parentId], references: [id], onDelete: Cascade)
  child  Subject @relation("SubjectAsChild", fields: [childId], references: [id], onDelete: Cascade)

  @@id([parentId, childId])
  @@index([childId])
}

// -------------------------------------------------------------- SRS + review

model UserSubject {
  id        String   @id @default(cuid())
  userId    String
  subjectId String

  unlockedAt DateTime  @default(now())
  startedAt  DateTime?

  srsStage Int       @default(0)
  dueAt    DateTime?

  passedAt DateTime?
  burnedAt DateTime?

  meaningCorrect   Int @default(0)
  meaningIncorrect Int @default(0)
  readingCorrect   Int @default(0)
  readingIncorrect Int @default(0)

  masteryLevel Int @default(0)
  masteryXp    Int @default(0)

  /// Last time this item advanced a stage. Drives the 4-hour promotion cap:
  /// see src/services/srs/transition.ts.
  lastPromotedAt DateTime?

  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  reviewLogs ReviewLog[]

  @@unique([userId, subjectId])
  @@index([userId, srsStage, dueAt])
  @@index([userId, passedAt])
}

model ReviewLog {
  id            String       @id @default(cuid())
  userSubjectId String
  sessionId     String?
  questionType  QuestionType

  incorrectCount Int
  startedStage   Int
  endedStage     Int
  answeredAt     DateTime     @default(now())

  userSubject UserSubject @relation(fields: [userSubjectId], references: [id], onDelete: Cascade)

  @@index([userSubjectId, answeredAt])
  @@index([answeredAt])
}

model Session {
  id     String      @id @default(cuid())
  userId String
  kind   SessionKind

  /// What was in play: subject ids, level range, etc. Shape depends on kind.
  scope Json?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  totalItems   Int   @default(0)
  correctItems Int   @default(0)
  scorePct     Float?
  xpAwarded    Int   @default(0)

  @@index([userId, kind, startedAt])
}

// ------------------------------------------------------------------ Profile

model UserProfile {
  userId String @id

  displayName  String
  avatarPath   String?

  /// EXP track: time invested. Monotonic, unbounded, and the sole driver of
  /// accountLevel (see src/services/xp/curve.ts).
  totalXp      BigInt @default(0)
  accountLevel Int    @default(1)

  /// LP track: current performance. Independent of totalXp — moved only by
  /// ranked reviews and exams, and able to fall. See src/services/rank/lp.ts.
  /// `rankDivision` is null for Master and above, which share one unbounded
  /// LP pool instead of divisions.
  rank         String @default("IRON")
  rankDivision Int?   @default(4)
  lp           Int    @default(0)

  /// High-water mark, so a demotion can still show what was achieved.
  peakRank         String @default("IRON")
  peakRankDivision Int?   @default(4)

  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastActiveDay DateTime? @db.Date

  timezone String @default("Asia/Tokyo")

  /// User-controlled preferences, e.g. { furiganaOverride: true|false|null }.
  settings Json @default("{}")
}

model DailyActivity {
  userId String
  day    DateTime @db.Date

  reviewCount Int @default(0)
  lessonCount Int @default(0)
  xpEarned    Int @default(0)

  @@id([userId, day])
}

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  sessionId String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Mirrors XpEvent for the LP track. LP is the only progression value that
/// can decrease, so without a log a drop is unexplainable and unauditable —
/// this is what lets the UI answer "why did I lose rank?".
model LpEvent {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  reason    String // "review" | "exam"
  sessionId String?

  /// Session shape that produced `delta`, kept so the formula can be
  /// re-derived (and retuned) against real history.
  accuracy  Float
  itemCount Int

  /// Ladder position after applying `delta`.
  tierAfter     String
  divisionAfter Int?
  lpAfter       Int

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// -------------------------------------------------------------- Tutorials

model Tutorial {
  id     String @id @default(cuid())
  slug   String @unique
  order  Int

  titleEn String
  titleJa String
  /// Markdown. Seeded on create only — see scripts/seed/lib/tutorials.ts and
  /// load.ts's tutorial upsert, which never overwrites a body the user has
  /// since edited (same treatment as Subject's USER-AUTHORED block).
  body    String

  /// Discriminated union — see src/services/tutorials/trigger-types.ts.
  trigger Json

  required         Boolean @default(false)
  estimatedMinutes Int     @default(2)

  completions TutorialCompletion[]
}

model TutorialCompletion {
  userId      String
  tutorialId  String
  completedAt DateTime @default(now())
  acknowledged Boolean @default(true)

  tutorial Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  @@id([userId, tutorialId])
  @@index([userId])
}

// --------------------------------------------------------------- Attribution

/// Backs the required license attribution screen (/about). One row per
/// upstream dataset the seed scripts pull from (JMdict, KanjiVG, etc.).
model DataSource {
  id           String   @id @default(cuid())
  name         String
  url          String
  license      String
  versionDate  DateTime @db.Date
  attribution  String
}
